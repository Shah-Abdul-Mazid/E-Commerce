# Production Managed PostgreSQL (e.g. Render PostgreSQL or Supabase):
# DATABASE_URL=postgresql+asyncpg://username:password@dpg-xxx.render.com/samjap_mart_db

# -----------------------------------------------------------------
# Dutch-Bangla Bank & NexusPay Memo Settings
# -----------------------------------------------------------------
DBBL_RECEIVER_NAME="SAMJAP MART (MAZID & POPY)"
DBBL_RECEIVER_ACCOUNT="107.110.198425"

# -----------------------------------------------------------------
# Application URLs (Crucial for SSLCommerz Callbacks & Redirects)
# -----------------------------------------------------------------
# In local development:
# APP_BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5174

# In production (Render + Vercel):
APP_BASE_URL=https://your-backend.onrender.com
FRONTEND_URL=https://your-frontend.vercel.app

# -----------------------------------------------------------------
# SSLCommerz Payment Gateway Credentials
# -----------------------------------------------------------------
# Sandbox credentials (default):
