PROJECT_NAME="SAMJAP Mart — Shah Abdul Mazid ❤️ Jannat Farhana Popy"
SECRET_KEY="samjap-mart-super-secret-jwt-key-2026-mazid-loves-popy"

# -----------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------
# Local / Default SQLite:
