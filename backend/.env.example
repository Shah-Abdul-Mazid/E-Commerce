# =================================================================
# EZOPY MART TECH Backend - Environment Variables Template
# Copy this to .env for local testing or configure on Vercel Dashboard
# =================================================================

PROJECT_NAME="EZOPY MART TECH"
SECRET_KEY="replace-with-your-secret-jwt-key"

# -----------------------------------------------------------------
# MongoDB Atlas Configuration
# -----------------------------------------------------------------
MONGODB_DATABASE="mongodb+srv://username:password@cluster.mongodb.net/EcommarceDB?retryWrites=true&w=majority"
MONGODB_DB_NAME="EcommarceDB"

# -----------------------------------------------------------------
# Dutch-Bangla Bank & NexusPay Memo Settings
# -----------------------------------------------------------------
DBBL_RECEIVER_NAME="EZOPY MART TECH"
DBBL_RECEIVER_ACCOUNT="107.110.****25"

# -----------------------------------------------------------------
# Application URLs (Leave empty for single-project Vercel deployment)
# -----------------------------------------------------------------
APP_BASE_URL=
FRONTEND_URL=

# -----------------------------------------------------------------
# SSLCommerz Payment Gateway Credentials
# -----------------------------------------------------------------
SSL_STORE_ID=your_store_id
SSL_STORE_PASSWORD=your_store_password
SSL_IS_LIVE=false
